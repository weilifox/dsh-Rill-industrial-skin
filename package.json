{
  "name": "dsh-rill-industrial-skin",
  "version": "1.3.6",
  "description": "Seven desaturated palettes: 黛蓝 / 宋青 / 橙青 / 深蓝 / 粉霞 / 暮紫 / 赭笺. Palette never touches text colour — except 赭笺, the one paper palette that flips the type to ink so it stays readable.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tools",
    ".gitattributes",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skin",
    "theme",
    "industrial"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weilifox/dsh-Rill-industrial-skin.git"
  },
  "homepage": "https://github.com/weilifox/dsh-Rill-industrial-skin#readme",
  "bugs": {
    "url": "https://github.com/weilifox/dsh-Rill-industrial-skin/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
